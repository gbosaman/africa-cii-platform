# ---------------------------------------------------------------------------
# Africa Creative Industries Intelligence Platform — environment template
# Copy to `.env.local` and fill in. NEVER commit real secrets.
#
# The app RUNS WITHOUT any of these set: it falls back to the built-in
# verified seed + live World Bank API. Supabase unlocks persistence,
# auth, watchlists, and the admin console.
# ---------------------------------------------------------------------------

# --- Supabase (optional for local dev, required for production persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by ingestion jobs & admin routes. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional external data-source API keys (Phase 2+) ---
# Free tiers. Leave blank to keep those adapters disabled (metrics show N/A).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_WEB_API_KEY=
RAWG_API_KEY=
GITHUB_TOKEN=

# World Bank API requires NO key. IMF, OpenAlex, Crossref are also keyless.

# --- Admin console ---
# Server-only passphrase that unlocks /admin. Leave blank to keep the console
# LOCKED (no write access is ever exposed). Writes also require the Supabase
# service-role key above. Use a long random string.
ADMIN_ACCESS_KEY=

# --- App config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
